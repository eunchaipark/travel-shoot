{
  "settings": {
    "number_of_shards": 3,
    "number_of_replicas": 1,
    "analysis": {
      "tokenizer": {
        "nori_tokenizer": {
          "type": "nori_tokenizer",
          "decompound_mode": "mixed"
        },
        "ngram_tokenizer": {
          "type": "ngram",
          "min_gram": 2,
          "max_gram": 3,
          "token_chars": ["letter", "digit"]
        }
      },
      "filter": {
        "nori_posfilter": {
          "type": "nori_part_of_speech",
          "stoptags": [
            "E", "IC", "J", "MAG", "MM", "SP", "SSC", "SSO", "SC", "SE", "XPN", "XSA", "XSN", "XSV", "UNA", "NA", "VSV"
          ]
        }
      },
      "analyzer": {
        "korean_nori_analyzer": {
          "type": "custom",
          "tokenizer": "nori_tokenizer",
          "filter": ["lowercase", "nori_posfilter", "nori_readingform"]
        },
        "korean_ngram_analyzer": {
          "type": "custom",
          "tokenizer": "ngram_tokenizer",
          "filter": ["lowercase"]
        }
      }
    }
  },
  "mappings": {
    "properties": {
      "stayId": { "type": "long" },
      "name": {
        "type": "text",
        "analyzer": "korean_nori_analyzer",
        "fields": {
          "ngram": {
            "type": "text",
            "analyzer": "korean_ngram_analyzer"
          },
          "keyword": {
            "type": "keyword"
          }
        }
      },
      "stayType": { "type": "keyword" },
      "region": {
        "properties": {
          "areaName": {
            "type": "text",
            "analyzer": "korean_nori_analyzer",
            "fields": {
              "keyword": { "type": "keyword" }
            }
          },
          "cityName": {
            "type": "text",
            "analyzer": "korean_nori_analyzer",
            "fields": {
              "keyword": { "type": "keyword" }
            }
          }
        }
      },
      "address": {
        "type": "text",
        "analyzer": "korean_nori_analyzer"
      },
      "location": {
        "type": "geo_point"
      },
      "amenities": { "type": "keyword" },
      "rating": { "type": "float" },
      "reviewCount": { "type": "integer" },
      "minPrice": { "type": "integer" },
      "checkInTime": { "type": "keyword" },
      "checkOutTime": { "type": "keyword" },
      "isActive": { "type": "boolean" },
      "rooms": {
        "type": "nested",
        "properties": {
          "roomId": { "type": "long" },
          "roomName": { 
            "type": "text",
            "analyzer": "korean_nori_analyzer"
          },
          "capacity": { "type": "integer" },
          "bedroomCount": { "type": "integer" },
          "bathroomCount": { "type": "integer" },
          "weekdayPrice": { "type": "integer" },
          "weekendPrice": { "type": "integer" }
        }
      }
    }
  }
}